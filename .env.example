# ============================================================
# Copy this file to .env, then replace all placeholder values.
# .env is ignored by git and must never be committed.
# ============================================================

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# For HTTPS production behind Nginx, for example:
# CSRF_TRUSTED_ORIGINS=https://demo.example.com
CSRF_TRUSTED_ORIGINS=
# Enable these only after HTTPS is working end-to-end.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0

# PostgreSQL on Aliyun ECS. The local development fallback is SQLite when
# DATABASE_URL is omitted; production must always set it.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://webgen:change-me@127.0.0.1:5432/webgen
DB_SSL_REQUIRE=False

# DeepSeek OpenAI-compatible API (used for single generation and refinement)
# Leave LLM_API_KEY empty to force the built-in Mock calculator fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# Qwen OpenAI-compatible API (used as the second contestant in race mode).
# Qwen Token Plan keys start with sk-sp- and use the token-plan endpoint below.
# If you use a standard DashScope key, switch QWEN_BASE_URL to:
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash
QWEN_TIMEOUT=60

# 全栈项目代码生成超时（后端代码输出较长）
BACKEND_TIMEOUT=90
# 千问生成完整项目明显更慢；单独给千问更大的后台预算，避免 90 秒读超时
QWEN_BACKEND_TIMEOUT=180
