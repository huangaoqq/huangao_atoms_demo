# --- Django ---
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# 本地 PostgreSQL；Render 会通过 Blueprint / 后台自动注入 DATABASE_URL。
# 不配置 DATABASE_URL 时项目会回退 SQLite，方便无数据库环境快速验收。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/loom

# Render 自定义域名或额外来源时填写，多个用英文逗号分隔。
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# --- LLM (DeepSeek, OpenAI-compatible) ---
# 留空即进入 Mock 兜底模式；不要在源码中硬编码密钥。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
